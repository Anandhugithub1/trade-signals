SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# CoinDCX API credentials — generate at https://coindcx.com/api-dashboard
# Only required to run in --live mode; dry-run works without them.
COINDCX_API_KEY=
COINDCX_API_SECRET=

# Sizing / risk controls — see handler.py's module docstring for what
# each one guards against before changing the defaults.
MAX_POSITION_USDT=50
EXECUTE_LEVERAGE=2
EXECUTE_RISK_PCT=0.01
EXECUTE_ACCOUNT_CAPITAL_USDT=1000

# Second switch required (alongside the --live CLI flag) before any real
# order is sent. Leave unset/false until you have verified the
# UNVERIFIED items in handler.py's module docstring against CoinDCX
# directly.
EXECUTE_LIVE=false
