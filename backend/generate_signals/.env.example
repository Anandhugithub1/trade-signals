SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Firebase service account JSON (entire file content, single line or multi-line).
# How to get it:
#   Firebase Console → Project Settings → Service Accounts → Generate new private key
#   Copy the full contents of the downloaded .json file here.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"..."}
